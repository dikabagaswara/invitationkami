# App Branding
APP_NAME=InvitationKami
APP_TAGLINE=Undangan Digital Modern
APP_URL=http://localhost:3000
APP_LOGO=/images/logo.svg
APP_FAVICON=/favicon.ico

# Database
DATABASE_URL=postgresql://invitationkami:password@localhost:5432/invitationkami

# Auth (generate: openssl rand -base64 32)
AUTH_SECRET=your-secret-here-change-in-production
AUTH_URL=http://localhost:3000

# Storage
STORAGE_ADAPTER=local
UPLOAD_DIR=./public/uploads
UPLOAD_MAX_SIZE_BYTES=5242880

# DB Docker
DB_USER=invitationkami
DB_PASSWORD=change-me-in-production
DB_NAME=invitationkami
